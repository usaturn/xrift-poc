# 制作物の作業場所。各ワールド・アイテムは、その中の独立した Git リポジトリで管理する
/items/
/worlds/

# worktree の作業場所
/.worktrees/
/.claude/worktrees/

# ローカルの作業用ファイル
/tmp/
/reviews/
/docs_draft/
# superpowers の作業用ディレクトリ。brainstorming の visual companion が、mockup と接続用のトークン（.last-token）を書く
.superpowers/

# Dev Containers がコンテナの作成時に書く、features の解決結果のロックファイル
/.devcontainer/devcontainer-lock.json

# 認証情報
.env
.env.*
.secrets/

# 依存パッケージ・キャッシュ
node_modules/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# セットアップで取得する XRift 公式スキル（scripts/install_xrift_skills.bash）
/.agents/skills/xrift-*/
/.claude/skills/xrift-*
/skills-lock.json
