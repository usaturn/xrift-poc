#!/usr/bin/env zsh

set -euo pipefail

typeset -a PI_SUPERAGENTS_HELPER_CANDIDATES=(
    "${0:A:h}/pi-superagents-exec.zsh"
    "${HOME}/.local/bin/pi-superagents-exec.zsh"
)
typeset PI_SUPERAGENTS_HELPER=""
for _candidate in "${PI_SUPERAGENTS_HELPER_CANDIDATES[@]}"; do
    if [[ -f "${_candidate}" ]]; then
        PI_SUPERAGENTS_HELPER="${_candidate}"
        break
    fi
done
unset _candidate
if [[ -z "${PI_SUPERAGENTS_HELPER}" ]]; then
    print -ru2 -- "[${0:t}] ERROR: pi-superagents-exec.zsh が見つかりません。"
    print -ru2 -- ""
    print -ru2 -- "リポジトリのルートで setup スクリプトを一度実行してください:"
    print -ru2 -- ""
    print -ru2 -- "  zsh scripts/setup_pi_superagents.zsh"
    exit 1
fi
source "${PI_SUPERAGENTS_HELPER}"

pi_openai_codex_require_oauth || exit 1

#
# Compatibility with the environment variable used by an older setup.
#
if [[ -z "${OPENCODE_API_KEY:-}" && -n "${OPENCODE_GO_API_KEY:-}" ]]; then
    export OPENCODE_API_KEY="${OPENCODE_GO_API_KEY}"
fi

#
# cheap tier の子 Pi は opencode-go/deepseek-v4.1-flash を使う。
# opencode-go の資格情報は auth.json の api_key または OPENCODE_API_KEY で
# 解決されるため、pigo / pigod / pixg と同じく起動前の認証チェックは
# 行わない。親 Pi と balanced / max tier は openai-codex のままなので、
# 上の Codex OAuth チェックは維持する。
#
pi_superagents_exec pigs \
    --provider openai-codex \
    --model gpt-6.1-sol \
    --thinking xhigh \
    "$@" || exit 1
