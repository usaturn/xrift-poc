#!/usr/bin/env zsh

set -euo pipefail

# install 後は同じ bin、リポジトリからの直接起動時は .devcontainer/ のヘルパを使う。
typeset -a PI_SUPERAGENTS_HELPER_CANDIDATES=(
    "${0:A:h}/pi-superagents-exec.zsh"
    "${HOME}/.local/bin/pi-superagents-exec.zsh"
)
typeset PI_SUPERAGENTS_HELPER=""
for _candidate in "${PI_SUPERAGENTS_HELPER_CANDIDATES[@]}"; do
    if [[ -f "${_candidate}" ]]; then
        PI_SUPERAGENTS_HELPER="${_candidate}"
        break
    fi
done
unset _candidate
if [[ -z "${PI_SUPERAGENTS_HELPER}" ]]; then
    print -ru2 -- "[pidid] ERROR: pi-superagents-exec.zsh が見つかりません。"
    print -ru2 -- "リポジトリのルートで zsh scripts/setup_pi.zsh を実行してください。"
    exit 1
fi
source "${PI_SUPERAGENTS_HELPER}"

typeset PI_DIR="${PI_CODING_AGENT_DIR:-${HOME}/.pi/agent}"
if [[ "${PI_DIR}" == "~" ]]; then
    PI_DIR="${HOME}"
elif [[ "${PI_DIR}" == "~/"* ]]; then
    PI_DIR="${HOME}/${PI_DIR#'~/'}"
fi
readonly MODELS_JSON="${PI_DIR}/models.json"
readonly PROVIDER="deepinfra"
readonly MODEL="deepseek-ai/DeepSeek-V4.1-Flash-1017"

if [[ -z "${DEEPINFRA_TOKEN:-}" ]]; then
    print -ru2 -- "[pidid] ERROR: DEEPINFRA_TOKEN is not set."
    print -ru2 -- '利用者自身でトークンを用意し、export DEEPINFRA_TOKEN="..." してから再実行してください。'
    exit 1
fi

# deepinfra は独自 provider。旧雛形だけの環境ではモデルを解決できない。
# 読めない・壊れた定義でもチェックを省略しない。例外や入力内容は表示せず止める。
if ! node -e '
const fs = require("node:fs");
try {
    const data = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    const models = data.providers?.[process.argv[2]]?.models;
    if (!Array.isArray(models) || !models.some((model) => model?.id === process.argv[3])) {
        process.exit(1);
    }
} catch {
    process.exit(1);
}
' "${MODELS_JSON}" "${PROVIDER}" "${MODEL}" >/dev/null 2>&1; then
    print -ru2 -- "[pidid] ERROR: models.json の DeepInfra モデル登録を確認できません。起動を中止します。"
    print -ru2 -- "DEEPINFRA_TOKEN を export し、リポジトリのルートで zsh scripts/setup_pi.zsh を実行してください。"
    print -ru2 -- "PI_CODING_AGENT_DIR を指定している場合は、同じ設定先で更新してください。"
    exit 1
fi

# ID がファイルにあっても、スキーマ不正なら Pi の実効一覧には登録されない。
# 共通ヘルパは診断から入力値を除き、カタログ更新や資格情報の取得もしない。
if [[ "${PI_SUPERAGENTS_LAUNCHER_DRY_RUN:-}" != "1" ]]; then
    if ! pi_require_exact_model "${PROVIDER}" "${MODEL}"; then
        print -ru2 -- "DeepInfra の定義は zsh scripts/setup_pi.zsh で明示更新してください。"
        exit 1
    fi
fi

pi_superagents_exec pidid \
    --provider "${PROVIDER}" \
    --model "${MODEL}" \
    --models "${MODEL}" \
    --thinking high \
    "$@" || exit 1
