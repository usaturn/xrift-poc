#!/usr/bin/env zsh

set -euo pipefail

#
# pi-superagents のランチャー別設定を適用する共通ヘルパ。
# install_beforehand.bash は本体と一緒に ~/.local/bin へ配置する。
# リポジトリから直接実行する場合は .devcontainer/ 側を使う。
#
typeset -a PI_SUPERAGENTS_HELPER_CANDIDATES=(
    "${0:A:h}/pi-superagents-exec.zsh"
    "${HOME}/.local/bin/pi-superagents-exec.zsh"
)
typeset PI_SUPERAGENTS_HELPER=""
for _candidate in "${PI_SUPERAGENTS_HELPER_CANDIDATES[@]}"; do
    if [[ -f "${_candidate}" ]]; then
        PI_SUPERAGENTS_HELPER="${_candidate}"
        break
    fi
done
unset _candidate
if [[ -z "${PI_SUPERAGENTS_HELPER}" ]]; then
    print -ru2 -- "[${0:t}] ERROR: pi-superagents-exec.zsh が見つかりません。"
    print -ru2 -- ""
    print -ru2 -- "リポジトリのルートで setup スクリプトを一度実行してください:"
    print -ru2 -- ""
    print -ru2 -- "  zsh scripts/setup_pi_superagents.zsh"
    exit 1
fi
source "${PI_SUPERAGENTS_HELPER}"

# ADC の解決・検証は Pi に任せる。API key はこのプロセスツリーだけで外す。
export GOOGLE_CLOUD_PROJECT="${GOOGLE_CLOUD_PROJECT:-${GCLOUD_PROJECT:-hobby-372711}}"
export GOOGLE_CLOUD_LOCATION="${GOOGLE_CLOUD_LOCATION:-global}"
unset GOOGLE_CLOUD_API_KEY

pi_superagents_exec pigema \
    --provider google-vertex \
    --model gemini-4-argon \
    --thinking high \
    "$@" || exit 1
